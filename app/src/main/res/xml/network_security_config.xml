<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security configuration for MyBudgets.

    FinTS/HBCI communication uses HTTPS exclusively for modern banks (FinTS 3.0+).
    Some legacy bank servers may still use older TLS configurations.
    This config trusts the system CA store (default behavior) and allows
    debug builds to use cleartext for local backend development only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext only in debug builds for local backend (e.g. http://192.168.x.x) -->
    <debug-overrides cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!--
        Das eigene Backend im Heimnetz ist bewusst nur ueber http:// erreichbar.
        Die domain-config gilt unabhaengig vom Buildtyp - damit kann die App das Backend
        auch dann erreichen, wenn sie ohne debuggable-Flag ausgeliefert wurde.
        Bewusst auf einzelne Hosts beschraenkt: alles andere bleibt auf HTTPS festgenagelt.
        Aendert sich die IP des Servers, muss sie hier ergaenzt werden.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.178.37</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
