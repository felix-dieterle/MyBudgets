<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sync-Einstellungen"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:layout_marginBottom="24dp" />

        <!-- SecureGo Wait Time -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SecureGo Wartezeit"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Zeit zum Bestätigen in SecureGo-App"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:alpha="0.7"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_securego_wait"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="10"
                        android:valueTo="60"
                        android:stepSize="5" />

                    <TextView
                        android:id="@+id/tv_securego_wait"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30s"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:minWidth="50dp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bulk Sync Delay -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bulk-Sync Verzögerung"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pause zwischen historischen Abfragen"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:alpha="0.7"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_bulk_delay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="2"
                        android:valueTo="10"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/tv_bulk_delay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5s"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:minWidth="50dp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DNS Retry Count -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DNS-Fehler Wiederholungen"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Anzahl Retries bei Netzwerk-Fehlern"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:alpha="0.7"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_dns_retry_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="0"
                        android:valueTo="5"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/tv_dns_retry_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:minWidth="50dp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DNS Retry Delay -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DNS-Retry Verzögerung"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pause vor erneutem Versuch"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:alpha="0.7"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_dns_retry_delay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="1"
                        android:valueTo="10"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/tv_dns_retry_delay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3s"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:minWidth="50dp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Debug: Undo Last Syncs -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFF3E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔧 Debug: Syncs rückgängig"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Löscht die letzten N Sync-Intervalle inkl. Transaktionen (für Test nach Bulk-Load)"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:alpha="0.7"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_undo_syncs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="1"
                        android:valueTo="10"
                        android:stepSize="1"
                        android:value="3" />

                    <TextView
                        android:id="@+id/tv_undo_syncs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:minWidth="50dp"
                        android:gravity="end" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_undo_syncs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Letzte N Syncs löschen"
                    style="@style/Widget.Material3.Button.TonalButton"
                    app:icon="@android:drawable/ic_menu_revert" />
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wiederholende Buchungen"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Erkennt Muster in allen Transaktionen neu. Bestehende Marker können zurückgesetzt werden."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:alpha="0.7"
                    android:layout_marginBottom="12dp" />
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_recurrence_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Muster neu erkennen"
                    style="@style/Widget.Material3.Button.TonalButton"
                    app:icon="@android:drawable/ic_menu_rotate" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reset Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auf Standard zurücksetzen"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
